                  <th>Name</th>
                  <th>Party</th>
                  <th>Election</th>
                  <th>Status</th>
                  <th>Symbol</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {data.candidates.map(candidate => (
                  <tr key={candidate.id}>
