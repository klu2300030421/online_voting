                    <td>{candidate.party || 'Independent'}</td>
                    <td>{candidate.election?.title || 'Not Assigned'}</td>
                    <td>
                      <span className={`status ${candidate.status?.toLowerCase()}`}>
                        {candidate.status}
                      </span>
