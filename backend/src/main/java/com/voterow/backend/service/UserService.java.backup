package com.voterow.backend.service;

import com.voterow.backend.model.AdminRole;
import com.voterow.backend.model.User;
import com.voterow.backend.model.UserType;
import com.voterow.backend.repository.UserRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.Random;

@Service
@RequiredArgsConstructor
@Transactional
public class UserService {

    private final UserRepository userRepository;
    private final PasswordEncoder passwordEncoder;
    private final AuditLogService auditLogService;

    public List<User> getAllUsers() {
        return userRepository.findAll();
    }

    public List<User> getUsersByType(UserType userType) {
        return userRepository.findByUserType(userType);
    }

    public List<User> getActiveUsers() {
        return userRepository.findByIsActive(true);
    }

    public List<User> getInactiveUsers() {
        return userRepository.findByIsActive(false);
    }

    public User toggleUserStatus(Long userId) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));
        user.setIsActive(!user.getIsActive());
        user.setUpdatedAt(LocalDateTime.now());
        return userRepository.save(user);
    }

    public User createUser(String fullName, String email, String password, Integer age, String userType) {
        // Check if email already exists
        if (userRepository.findByEmail(email).isPresent()) {
            throw new RuntimeException("Email already in use");
        }

        User user = new User();
        user.setFullName(fullName);
        user.setEmail(email);
        user.setPassword(passwordEncoder.encode(password));
        user.setAge(age);
        user.setIsActive(true);
        user.setCreatedAt(LocalDateTime.now());
        user.setUpdatedAt(LocalDateTime.now());

        // Map user type string to enum
        UserType type;
        switch (userType.toUpperCase()) {
            case "VOTER":
                type = UserType.ROLE_VOTER;
                break;
            case "PARTICIPANT":
            case "CANDIDATE":
                type = UserType.ROLE_PARTICIPANT;
                break;
            case "ADMIN":
                type = UserType.ROLE_ADMIN;
                user.setAdminRole(AdminRole.SUB_ADMIN); // Default admin role
                break;
            default:
                throw new RuntimeException("Invalid user type: " + userType);
        }
        user.setUserType(type);

        return userRepository.save(user);
    }

    public User updateUser(Long userId, String fullName, String email, Integer age, String userType) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));

        // Check if email is being changed to an existing one
        Optional<User> existingUser = userRepository.findByEmail(email);
        if (existingUser.isPresent() && !existingUser.get().getId().equals(userId)) {
            throw new RuntimeException("Email already in use");
        }

        user.setFullName(fullName);
        user.setEmail(email);
        user.setAge(age);
        user.setUpdatedAt(LocalDateTime.now());

        // Map user type string to enum
        UserType type;
        switch (userType.toUpperCase()) {
            case "VOTER":
                type = UserType.ROLE_VOTER;
                user.setAdminRole(null); // Clear admin role if changing from admin
                break;
            case "PARTICIPANT":
            case "CANDIDATE":
                type = UserType.ROLE_PARTICIPANT;
                user.setAdminRole(null); // Clear admin role if changing from admin
                break;
            case "ADMIN":
                type = UserType.ROLE_ADMIN;
                if (user.getAdminRole() == null) {
                    user.setAdminRole(AdminRole.SUB_ADMIN); // Default admin role
                }
                break;
            default:
                throw new RuntimeException("Invalid user type: " + userType);
        }
        user.setUserType(type);

        return userRepository.save(user);
    }

    public void deleteUser(Long userId) {
        if (!userRepository.existsById(userId)) {
            throw new RuntimeException("User not found");
        }
        userRepository.deleteById(userId);
    }

    public User getUserById(Long userId) {
        return userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));
    }
    
    // Enhanced methods for comprehensive admin functionality
    public User createUserWithDetails(User user, User createdBy) {
        // Check if email already exists
        if (userRepository.findByEmail(user.getEmail()).isPresent()) {
            throw new RuntimeException("Email already in use");
        }
        
        user.setPassword(passwordEncoder.encode(user.getPassword()));
        user.setCreatedAt(LocalDateTime.now());
        user.setUpdatedAt(LocalDateTime.now());
        user.setIsActive(true);
        
        User saved = userRepository.save(user);
        
        auditLogService.logAction(createdBy, "CREATE_USER", "User", saved.getId(), 
            "Created user: " + saved.getFullName() + " (" + saved.getUserType() + ")");
        
        return saved;
    }
    
    public User updateUserDetails(Long userId, User userDetails, User updatedBy) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));

        // Check if email is being changed to an existing one
        Optional<User> existingUser = userRepository.findByEmail(userDetails.getEmail());
        if (existingUser.isPresent() && !existingUser.get().getId().equals(userId)) {
            throw new RuntimeException("Email already in use");
        }

        user.setFullName(userDetails.getFullName());
        user.setEmail(userDetails.getEmail());
        user.setAge(userDetails.getAge());
        user.setPhoneNumber(userDetails.getPhoneNumber());
        user.setIdProofNumber(userDetails.getIdProofNumber());
        user.setAddress(userDetails.getAddress());
        user.setUserType(userDetails.getUserType());
        user.setAdminRole(userDetails.getAdminRole());
        user.setUpdatedAt(LocalDateTime.now());

        User saved = userRepository.save(user);
        
        auditLogService.logAction(updatedBy, "UPDATE_USER", "User", saved.getId(), 
            "Updated user: " + saved.getFullName());
        
        return saved;
    }
    
    public void deleteUserSoft(Long userId, User deletedBy) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));
        
        user.setIsActive(false);
        user.setUpdatedAt(LocalDateTime.now());
        userRepository.save(user);
        
        auditLogService.logAction(deletedBy, "DELETE_USER", "User", userId, 
            "Soft deleted user: " + user.getFullName());
    }
    
    public User verifyUser(Long userId, User verifiedBy) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));
        
        user.setIsVerified(true);
        user.setUpdatedAt(LocalDateTime.now());
        User saved = userRepository.save(user);
        
        auditLogService.logAction(verifiedBy, "VERIFY_USER", "User", userId, 
            "Verified user: " + user.getFullName());
        
        return saved;
    }
    
    public String generateOTP(User user) {
        String otp = String.format("%06d", new Random().nextInt(999999));
        user.setOtpCode(otp);
        user.setOtpExpiry(LocalDateTime.now().plusMinutes(5)); // 5 minute expiry
        userRepository.save(user);
        return otp;
    }
    
    public boolean verifyOTP(User user, String otp) {
        if (user.getOtpCode() == null || user.getOtpExpiry() == null) {
            return false;
        }
        
        if (LocalDateTime.now().isAfter(user.getOtpExpiry())) {
            return false; // OTP expired
        }
        
        return user.getOtpCode().equals(otp);
    }
    
    public void clearOTP(User user) {
        user.setOtpCode(null);
        user.setOtpExpiry(null);
        userRepository.save(user);
    }
    
    public void updateLastLogin(User user) {
        user.setLastLoginAt(LocalDateTime.now());
        userRepository.save(user);
    }
    
    // ============= NEW COMPREHENSIVE ADMIN METHODS =============
    
    // Module 1: Authentication & Authorization
    public Map<String, Object> enable2FA(Long userId, User enabledBy) {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found"));
        
        user.setTwoFactorEnabled(true);
        user.setUpdatedAt(LocalDateTime.now());
        userRepository.save(user);
        
        // Generate initial setup OTP
        String otp = generateOTP(user);
        
        return Map.of(
            "message", "2FA enabled successfully",
            "setupOTP", otp,
            "status", "enabled"
        );
    }
    
    public boolean verify2FA(String email, String otp) {
        Optional<User> userOpt = userRepository.findByEmail(email);
        if (userOpt.isEmpty()) {
            return false;
        }
        
        User user = userOpt.get();
        return verifyOTP(user, otp);
    }
    
    // Module 2: Advanced Voter Management
    public User createVoter(User voter, User createdBy) {
        voter.setUserType(UserType.ROLE_VOTER);
        voter.setPassword(passwordEncoder.encode(voter.getPassword()));
        voter.setCreatedAt(LocalDateTime.now());
        voter.setUpdatedAt(LocalDateTime.now());
        voter.setIsActive(true);
        voter.setIsVerified(false);
        
        return userRepository.save(voter);
    }
    
    public User updateVoter(Long id, User voterDetails, User updatedBy) {
        User voter = userRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Voter not found"));
        
        voter.setFullName(voterDetails.getFullName());
        voter.setEmail(voterDetails.getEmail());
        voter.setAge(voterDetails.getAge());
        voter.setPhoneNumber(voterDetails.getPhoneNumber());
        voter.setIdProofNumber(voterDetails.getIdProofNumber());
        voter.setAddress(voterDetails.getAddress());
        voter.setUpdatedAt(LocalDateTime.now());
        
        return userRepository.save(voter);
    }
    
    public void deleteVoter(Long id, User deletedBy) {
        User voter = userRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Voter not found"));
        
        voter.setIsActive(false);
        voter.setUpdatedAt(LocalDateTime.now());
        userRepository.save(voter);
    }
    
    public Map<String, Object> importVotersFromCSV(org.springframework.web.multipart.MultipartFile file, User importedBy) {
        // CSV import logic would go here
        // For now, return a placeholder response
        return Map.of(
            "message", "CSV import functionality to be implemented",
            "importedCount", 0,
            "errors", List.of()
        );
    }
    
    public User verifyVoter(Long id, Map<String, Object> verificationData, User verifiedBy) {
        User voter = userRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Voter not found"));
        
        voter.setIsVerified(true);
        voter.setUpdatedAt(LocalDateTime.now());
        
        return userRepository.save(voter);
    }
    
    public User activateVoter(Long id, User activatedBy) {
        User voter = userRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Voter not found"));
        
        voter.setIsActive(true);
        voter.setUpdatedAt(LocalDateTime.now());
        
        return userRepository.save(voter);
    }
    
    // Module 10: System Settings & Configuration
    public List<User> getAdminUsers() {
        return userRepository.findByUserType(UserType.ROLE_ADMIN);
    }
    
    public User createAdminUser(User adminUser, User createdBy) {
        adminUser.setUserType(UserType.ROLE_ADMIN);
        if (adminUser.getAdminRole() == null) {
            adminUser.setAdminRole(AdminRole.SUB_ADMIN);
        }
        adminUser.setPassword(passwordEncoder.encode(adminUser.getPassword()));
        adminUser.setCreatedAt(LocalDateTime.now());
        adminUser.setUpdatedAt(LocalDateTime.now());
        adminUser.setIsActive(true);
        
        return userRepository.save(adminUser);
    }
    
    public User updateAdminPermissions(Long id, Map<String, Object> permissions, User updatedBy) {
        User admin = userRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Admin user not found"));
        
        String role = (String) permissions.get("adminRole");
        if (role != null) {
            admin.setAdminRole(AdminRole.valueOf(role));
        }
        
        admin.setUpdatedAt(LocalDateTime.now());
        return userRepository.save(admin);
    }
    
    public Map<String, Object> getSystemConfiguration() {
        return Map.of(
            "timezone", "UTC",
            "maxVotingHours", 24,
            "allowMultipleVoting", false,
            "requireVoterVerification", true,
            "enableAuditLogging", true
        );
    }
    
    public void updateSystemConfiguration(Map<String, Object> config, User updatedBy) {
        // System configuration update logic would go here
        // For now, this is a placeholder
    }
    
    public String createSystemBackup(User createdBy) {
        // Backup creation logic would go here
        String backupId = "backup_" + System.currentTimeMillis();
        return backupId;
    }
    
    public void restoreSystemBackup(String backupId, User restoredBy) {
        // Restore logic would go here
        // For now, this is a placeholder
    }
    
    public List<User> searchUsers(String keyword) {
        return userRepository.findByFullNameContainingIgnoreCaseOrEmailContainingIgnoreCase(keyword, keyword);
    }
    
    public boolean isEligibleToVote(User user, int minAge) {
        return user.getAge() != null && user.getAge() >= minAge && user.getIsVerified();
    }
}