package com.voterow.backend.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import com.voterow.backend.service.*;
import com.voterow.backend.model.*;
import com.voterow.backend.dto.*;
import com.voterow.backend.repository.UserRepository;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/admin")
@PreAuthorize("hasAuthority('ADMIN')")
@CrossOrigin(origins = {"http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:5176"})
public class AdminController {
    
    @Autowired
    private UserService userService;
    
    @Autowired
    private ElectionService electionService;
    
    @Autowired
    private CandidateService candidateService;
    
    @Autowired
    private AuditLogService auditLogService;
    
    @Autowired
    private NotificationService notificationService;
    
    @Autowired
    private UserRepository userRepository;
    
    private User getCurrentUser() {
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        return userRepository.findByEmail(auth.getName()).orElse(null);
    }

    // ============= MODULE 1: AUTHENTICATION & AUTHORIZATION =============
    
    @PostMapping("/auth/enable-2fa/{userId}")
    public ResponseEntity<Map<String, Object>> enable2FA(@PathVariable Long userId) {
        User user = getCurrentUser();
        Map<String, Object> response = userService.enable2FA(userId, user);
        auditLogService.logAction("ENABLE_2FA", "Enabled 2FA for user: " + userId, user);
        return ResponseEntity.ok(response);
    }
    
    @PostMapping("/auth/verify-2fa")
    public ResponseEntity<Map<String, String>> verify2FA(@RequestBody Map<String, String> request) {
        String email = request.get("email");
        String otp = request.get("otp");
        boolean isValid = userService.verify2FA(email, otp);
        Map<String, String> response = Map.of("status", isValid ? "success" : "failure");
        return ResponseEntity.ok(response);
    }
    
    @GetMapping("/auth/admin-roles")
    public ResponseEntity<List<AdminRole>> getAdminRoles() {
        return ResponseEntity.ok(List.of(AdminRole.values()));
    }

    // ============= MODULE 2: VOTER MANAGEMENT =============
    
    @GetMapping("/voters")
    public ResponseEntity<List<User>> getAllVoters() {
        return ResponseEntity.ok(userService.getUsersByType(UserType.ROLE_VOTER));
    }
    
    @PostMapping("/voters")
    public ResponseEntity<User> createVoter(@RequestBody User voter) {
        User currentUser = getCurrentUser();
        voter.setUserType(UserType.ROLE_VOTER);
        User newVoter = userService.createVoter(voter, currentUser);
        auditLogService.logAction("CREATE_VOTER", "Created voter: " + voter.getEmail(), currentUser);
        return ResponseEntity.ok(newVoter);
    }
    
    @PutMapping("/voters/{id}")
    public ResponseEntity<User> updateVoter(@PathVariable Long id, @RequestBody User voter) {
        User currentUser = getCurrentUser();
        User updatedVoter = userService.updateVoter(id, voter, currentUser);
        auditLogService.logAction("UPDATE_VOTER", "Updated voter: " + id, currentUser);
        return ResponseEntity.ok(updatedVoter);
    }
    
    @DeleteMapping("/voters/{id}")
    public ResponseEntity<Map<String, String>> deleteVoter(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        userService.deleteVoter(id, currentUser);
        auditLogService.logAction("DELETE_VOTER", "Deleted voter: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Voter deleted successfully"));
    }
    
    @PostMapping("/voters/import")
    public ResponseEntity<Map<String, Object>> importVoters(@RequestParam("file") MultipartFile file) {
        User currentUser = getCurrentUser();
        Map<String, Object> result = userService.importVotersFromCSV(file, currentUser);
        auditLogService.logAction("IMPORT_VOTERS", "Imported voters from CSV", currentUser);
        return ResponseEntity.ok(result);
    }
    
    @PutMapping("/voters/{id}/verify")
    public ResponseEntity<User> verifyVoter(@PathVariable Long id, @RequestBody Map<String, Object> verificationData) {
        User currentUser = getCurrentUser();
        User verifiedVoter = userService.verifyVoter(id, verificationData, currentUser);
        auditLogService.logAction("VERIFY_VOTER", "Verified voter: " + id, currentUser);
        return ResponseEntity.ok(verifiedVoter);
    }
    
    @PutMapping("/voters/{id}/activate")
    public ResponseEntity<User> activateVoter(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        User activatedVoter = userService.activateVoter(id, currentUser);
        auditLogService.logAction("ACTIVATE_VOTER", "Activated voter: " + id, currentUser);
        return ResponseEntity.ok(activatedVoter);
    }

    // ============= MODULE 3: CANDIDATE/PARTY MANAGEMENT =============
    
    @GetMapping("/candidates")
    public ResponseEntity<List<Candidate>> getAllCandidates() {
        return ResponseEntity.ok(candidateService.getAllCandidates());
    }
    
    @PostMapping("/candidates")
    public ResponseEntity<Candidate> createCandidate(@RequestBody Candidate candidate) {
        User currentUser = getCurrentUser();
        Candidate newCandidate = candidateService.registerCandidate(candidate, currentUser);
        auditLogService.logAction("CREATE_CANDIDATE", "Created candidate: " + candidate.getName(), currentUser);
        return ResponseEntity.ok(newCandidate);
    }
    
    @PutMapping("/candidates/{id}")
    public ResponseEntity<Candidate> updateCandidate(@PathVariable Long id, @RequestBody Candidate candidate) {
        User currentUser = getCurrentUser();
        Candidate updatedCandidate = candidateService.updateCandidate(id, candidate, currentUser);
        auditLogService.logAction("UPDATE_CANDIDATE", "Updated candidate: " + id, currentUser);
        return ResponseEntity.ok(updatedCandidate);
    }
    
    @PostMapping("/candidates/{id}/upload-symbol")
    public ResponseEntity<Candidate> uploadPartySymbol(@PathVariable Long id, @RequestParam("file") MultipartFile file) {
        User currentUser = getCurrentUser();
        Candidate candidate = candidateService.uploadPartySymbol(id, file, currentUser);
        auditLogService.logAction("UPLOAD_SYMBOL", "Uploaded symbol for candidate: " + id, currentUser);
        return ResponseEntity.ok(candidate);
    }
    
    @PutMapping("/candidates/{id}/approve")
    public ResponseEntity<Candidate> approveCandidate(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        Candidate candidate = candidateService.approveCandidate(id, currentUser);
        auditLogService.logAction("APPROVE_CANDIDATE", "Approved candidate: " + id, currentUser);
        return ResponseEntity.ok(candidate);
    }
    
    @PutMapping("/candidates/{id}/reject")
    public ResponseEntity<Candidate> rejectCandidate(@PathVariable Long id, @RequestBody Map<String, String> reason) {
        User currentUser = getCurrentUser();
        Candidate candidate = candidateService.rejectCandidate(id, reason.get("reason"), currentUser);
        auditLogService.logAction("REJECT_CANDIDATE", "Rejected candidate: " + id, currentUser);
        return ResponseEntity.ok(candidate);
    }

    // ============= MODULE 4: ELECTION MANAGEMENT =============
    
    @GetMapping("/elections")
    public ResponseEntity<List<Election>> getAllElections() {
        return ResponseEntity.ok(electionService.getAllElections());
    }
    
    @PostMapping("/elections")
    public ResponseEntity<Election> createElection(@RequestBody Election election) {
        User currentUser = getCurrentUser();
        Election newElection = electionService.createElection(election, currentUser);
        auditLogService.logAction("CREATE_ELECTION", "Created election: " + election.getTitle(), currentUser);
        return ResponseEntity.ok(newElection);
    }
    
    @PutMapping("/elections/{id}")
    public ResponseEntity<Election> updateElection(@PathVariable Long id, @RequestBody Election election) {
        User currentUser = getCurrentUser();
        Election updatedElection = electionService.updateElection(id, election, currentUser);
        auditLogService.logAction("UPDATE_ELECTION", "Updated election: " + id, currentUser);
        return ResponseEntity.ok(updatedElection);
    }
    
    @PostMapping("/elections/{id}/assign-candidate")
    public ResponseEntity<Map<String, String>> assignCandidateToElection(@PathVariable Long id, @RequestBody Map<String, Long> request) {
        User currentUser = getCurrentUser();
        electionService.assignCandidateToElection(id, request.get("candidateId"), currentUser);
        auditLogService.logAction("ASSIGN_CANDIDATE", "Assigned candidate to election: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Candidate assigned successfully"));
    }
    
    @PutMapping("/elections/{id}/schedule")
    public ResponseEntity<Election> scheduleElection(@PathVariable Long id, @RequestBody Map<String, String> schedule) {
        User currentUser = getCurrentUser();
        LocalDateTime startDate = LocalDateTime.parse(schedule.get("startDate"));
        LocalDateTime endDate = LocalDateTime.parse(schedule.get("endDate"));
        Election scheduledElection = electionService.scheduleElection(id, startDate, endDate, currentUser);
        auditLogService.logAction("SCHEDULE_ELECTION", "Scheduled election: " + id, currentUser);
        return ResponseEntity.ok(scheduledElection);
    }

    // ============= MODULE 5: VOTING PROCESS CONTROL =============
    
    @PostMapping("/elections/{id}/start")
    public ResponseEntity<Map<String, String>> startElection(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        electionService.startElection(id, currentUser);
        auditLogService.logAction("START_ELECTION", "Started election: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Election started successfully"));
    }
    
    @PostMapping("/elections/{id}/stop")
    public ResponseEntity<Map<String, String>> stopElection(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        electionService.stopElection(id, currentUser);
        auditLogService.logAction("STOP_ELECTION", "Stopped election: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Election stopped successfully"));
    }
    
    @GetMapping("/elections/{id}/live-activity")
    public ResponseEntity<Map<String, Object>> getLiveVotingActivity(@PathVariable Long id) {
        Map<String, Object> activity = electionService.getLiveVotingActivity(id);
        return ResponseEntity.ok(activity);
    }
    
    @PostMapping("/elections/{id}/handle-dispute")
    public ResponseEntity<Map<String, String>> handleDispute(@PathVariable Long id, @RequestBody Map<String, String> dispute) {
        User currentUser = getCurrentUser();
        electionService.handleDispute(id, dispute.get("description"), dispute.get("resolution"), currentUser);
        auditLogService.logAction("HANDLE_DISPUTE", "Handled dispute for election: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Dispute handled successfully"));
    }

    // ============= MODULE 6: RESULT MANAGEMENT =============
    
    @PostMapping("/elections/{id}/count-votes")
    public ResponseEntity<Map<String, Object>> countVotes(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        Map<String, Object> results = electionService.countVotes(id, currentUser);
        auditLogService.logAction("COUNT_VOTES", "Counted votes for election: " + id, currentUser);
        return ResponseEntity.ok(results);
    }
    
    @GetMapping("/elections/{id}/results")
    public ResponseEntity<Map<String, Object>> getElectionResults(@PathVariable Long id) {
        Map<String, Object> results = electionService.getElectionResults(id);
        return ResponseEntity.ok(results);
    }
    
    @PostMapping("/elections/{id}/publish-results")
    public ResponseEntity<Map<String, String>> publishResults(@PathVariable Long id) {
        User currentUser = getCurrentUser();
        electionService.publishResults(id, currentUser);
        auditLogService.logAction("PUBLISH_RESULTS", "Published results for election: " + id, currentUser);
        return ResponseEntity.ok(Map.of("message", "Results published successfully"));
    }
    
    @GetMapping("/elections/{id}/results/download")
    public ResponseEntity<byte[]> downloadResultsReport(@PathVariable Long id) {
        byte[] report = electionService.generateResultsReport(id);
        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=election_results_" + id + ".pdf")
                .contentType(MediaType.APPLICATION_PDF)
                .body(report);
    }

    // ============= MODULE 7: SECURITY & AUDIT =============
    
    @GetMapping("/audit-logs")
    public ResponseEntity<List<AuditLog>> getAuditLogs(@RequestParam(defaultValue = "0") int page, 
                                                       @RequestParam(defaultValue = "50") int size) {
        List<AuditLog> logs = auditLogService.getAuditLogs(page, size);
        return ResponseEntity.ok(logs);
    }
    
    @GetMapping("/audit-logs/user/{userId}")
    public ResponseEntity<List<AuditLog>> getUserAuditLogs(@PathVariable Long userId) {
        List<AuditLog> logs = auditLogService.getUserAuditLogs(userId);
        return ResponseEntity.ok(logs);
    }
    
    @GetMapping("/security/fraud-detection")
    public ResponseEntity<Map<String, Object>> getFraudDetectionReport() {
        Map<String, Object> report = auditLogService.generateFraudDetectionReport();
        return ResponseEntity.ok(report);
    }
    
    @PostMapping("/security/encrypt-votes/{electionId}")
    public ResponseEntity<Map<String, String>> encryptVotes(@PathVariable Long electionId) {
        User currentUser = getCurrentUser();
        electionService.encryptVotes(electionId, currentUser);
        auditLogService.logAction("ENCRYPT_VOTES", "Encrypted votes for election: " + electionId, currentUser);
        return ResponseEntity.ok(Map.of("message", "Votes encrypted successfully"));
    }

    // ============= MODULE 8: COMMUNICATION & NOTIFICATIONS =============
    
    @PostMapping("/notifications/send-sms")
    public ResponseEntity<Map<String, String>> sendSMS(@RequestBody Map<String, Object> smsData) {
        User currentUser = getCurrentUser();
        notificationService.sendSMS(smsData, currentUser);
        auditLogService.logAction("SEND_SMS", "Sent SMS notification", currentUser);
        return ResponseEntity.ok(Map.of("message", "SMS sent successfully"));
    }
    
    @PostMapping("/notifications/send-email")
    public ResponseEntity<Map<String, String>> sendEmail(@RequestBody Map<String, Object> emailData) {
        User currentUser = getCurrentUser();
        notificationService.sendEmail(emailData, currentUser);
        auditLogService.logAction("SEND_EMAIL", "Sent email notification", currentUser);
        return ResponseEntity.ok(Map.of("message", "Email sent successfully"));
    }
    
    @PostMapping("/notifications/broadcast")
    public ResponseEntity<Map<String, String>> broadcastNotification(@RequestBody Map<String, Object> notificationData) {
        User currentUser = getCurrentUser();
        notificationService.broadcastNotification(notificationData, currentUser);
        auditLogService.logAction("BROADCAST", "Broadcast notification sent", currentUser);
        return ResponseEntity.ok(Map.of("message", "Notification broadcast successfully"));
    }
    
    @GetMapping("/notifications/voter-queries")
    public ResponseEntity<List<Map<String, Object>>> getVoterQueries() {
        List<Map<String, Object>> queries = notificationService.getVoterQueries();
        return ResponseEntity.ok(queries);
    }
    
    @PostMapping("/notifications/respond-query/{queryId}")
    public ResponseEntity<Map<String, String>> respondToQuery(@PathVariable Long queryId, @RequestBody Map<String, String> response) {
        User currentUser = getCurrentUser();
        notificationService.respondToQuery(queryId, response.get("response"), currentUser);
        auditLogService.logAction("RESPOND_QUERY", "Responded to query: " + queryId, currentUser);
        return ResponseEntity.ok(Map.of("message", "Response sent successfully"));
    }

    // ============= MODULE 9: DASHBOARD & REPORTS =============
    
    @GetMapping("/dashboard/overview")
    public ResponseEntity<Map<String, Object>> getDashboardOverview() {
        Map<String, Object> overview = electionService.getDashboardOverview();
        return ResponseEntity.ok(overview);
    }
    
    @GetMapping("/dashboard/statistics")
    public ResponseEntity<Map<String, Object>> getStatistics() {
        Map<String, Object> stats = electionService.getElectionStatistics();
        return ResponseEntity.ok(stats);
    }
    
    @GetMapping("/reports/voter-turnout/{electionId}")
    public ResponseEntity<Map<String, Object>> getVoterTurnoutReport(@PathVariable Long electionId) {
        Map<String, Object> report = electionService.getVoterTurnoutReport(electionId);
        return ResponseEntity.ok(report);
    }
    
    @GetMapping("/reports/candidate-performance/{electionId}")
    public ResponseEntity<Map<String, Object>> getCandidatePerformanceReport(@PathVariable Long electionId) {
        Map<String, Object> report = electionService.getCandidatePerformanceReport(electionId);
        return ResponseEntity.ok(report);
    }
    
    @GetMapping("/reports/export/pdf/{electionId}")
    public ResponseEntity<byte[]> exportReportPDF(@PathVariable Long electionId) {
        byte[] pdfReport = electionService.exportReportPDF(electionId);
        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=election_report_" + electionId + ".pdf")
                .contentType(MediaType.APPLICATION_PDF)
                .body(pdfReport);
    }
    
    @GetMapping("/reports/export/excel/{electionId}")
    public ResponseEntity<byte[]> exportReportExcel(@PathVariable Long electionId) {
        byte[] excelReport = electionService.exportReportExcel(electionId);
        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=election_report_" + electionId + ".xlsx")
                .contentType(MediaType.APPLICATION_OCTET_STREAM)
                .body(excelReport);
    }

    // ============= MODULE 10: SYSTEM SETTINGS & CONFIGURATION =============
    
    @GetMapping("/settings/admin-users")
    public ResponseEntity<List<User>> getAdminUsers() {
        List<User> adminUsers = userService.getAdminUsers();
        return ResponseEntity.ok(adminUsers);
    }
    
    @PostMapping("/settings/admin-users")
    public ResponseEntity<User> createAdminUser(@RequestBody User adminUser) {
        User currentUser = getCurrentUser();
        adminUser.setUserType(UserType.ROLE_ADMIN);
        User newAdmin = userService.createAdminUser(adminUser, currentUser);
        auditLogService.logAction("CREATE_ADMIN", "Created admin user: " + adminUser.getEmail(), currentUser);
        return ResponseEntity.ok(newAdmin);
    }
    
    @PutMapping("/settings/admin-users/{id}/permissions")
    public ResponseEntity<User> updateAdminPermissions(@PathVariable Long id, @RequestBody Map<String, Object> permissions) {
        User currentUser = getCurrentUser();
        User updatedAdmin = userService.updateAdminPermissions(id, permissions, currentUser);
        auditLogService.logAction("UPDATE_PERMISSIONS", "Updated permissions for admin: " + id, currentUser);
        return ResponseEntity.ok(updatedAdmin);
    }
    
    @GetMapping("/settings/system-config")
    public ResponseEntity<Map<String, Object>> getSystemConfiguration() {
        Map<String, Object> config = userService.getSystemConfiguration();
        return ResponseEntity.ok(config);
    }
    
    @PutMapping("/settings/system-config")
    public ResponseEntity<Map<String, String>> updateSystemConfiguration(@RequestBody Map<String, Object> config) {
        User currentUser = getCurrentUser();
        userService.updateSystemConfiguration(config, currentUser);
        auditLogService.logAction("UPDATE_CONFIG", "Updated system configuration", currentUser);
        return ResponseEntity.ok(Map.of("message", "Configuration updated successfully"));
    }
    
    @PostMapping("/settings/backup")
    public ResponseEntity<Map<String, String>> createBackup() {
        User currentUser = getCurrentUser();
        String backupId = userService.createSystemBackup(currentUser);
        auditLogService.logAction("CREATE_BACKUP", "Created system backup: " + backupId, currentUser);
        return ResponseEntity.ok(Map.of("message", "Backup created successfully", "backupId", backupId));
    }
    
    @PostMapping("/settings/restore/{backupId}")
    public ResponseEntity<Map<String, String>> restoreBackup(@PathVariable String backupId) {
        User currentUser = getCurrentUser();
        userService.restoreSystemBackup(backupId, currentUser);
        auditLogService.logAction("RESTORE_BACKUP", "Restored system backup: " + backupId, currentUser);
        return ResponseEntity.ok(Map.of("message", "System restored successfully"));
    }
}
